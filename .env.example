# ─────────────────────────────────────────────────────────────────────────
# Chatbot voice-server configuration (top-level rag_pipeline/)
# All values shown are defaults; uncomment + edit only what you want to override.
# Loaded by chatbot/config.py (Pydantic settings).
# ─────────────────────────────────────────────────────────────────────────

# ── Public-facing URLs ───────────────────────────────────────────────────
# BASE_URL must point at the public HTTPS URL Twilio dials (zrok / ngrok / etc).
BASE_URL=
RAG_API_URL=http://localhost:8000

# ── Ollama (OpenAI-compatible API surface) ───────────────────────────────
# Must end with /v1 (the OpenAI-compat shim path).
OLLAMA_BASE_URL=http://192.168.50.150:11434/v1
OLLAMA_KEEP_ALIVE=-1

# Model names. Keep them split so a smaller/faster model can drive
# the rewriter and end-of-call classifier without touching the main reply.
LLM_MODEL=phi4:latest
VOICE_LLM_MODEL=phi4:latest
VOICE_FAST_MODEL=phi4:latest

# ── Sync chat client tuning (chatbot/llm.py) ─────────────────────────────
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_RETRIES=3

# ── Voice streaming reply ────────────────────────────────────────────────
VOICE_MAX_TOKENS=500
VOICE_TEMPERATURE=0.3
VOICE_TOP_K=7

# ── Rewrite + end-of-call classifier (small deterministic hops) ──────────
REWRITE_MAX_TOKENS=150
REWRITE_TEMPERATURE=0.0
REWRITE_HISTORY_TURNS=6

# ── Conversation / context ──────────────────────────────────────────────
LLM_HISTORY_TURNS=20
MAX_CONVERSATION_TURNS=30
SESSION_TIMEOUT=1800
SESSION_CLEANUP_INTERVAL=300

# ── TTS pacing — 'fast first, smooth after' ─────────────────────────────
TTS_FIRST_FLUSH_WORDS=8
TTS_FIRST_FLUSH_CHARS=60

# ── HTTP ────────────────────────────────────────────────────────────────
RAG_HTTP_TIMEOUT=15.0

# ── Locale ──────────────────────────────────────────────────────────────
TIMEZONE=America/Toronto

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated origin list. '*' allows all (dev only).
CHATBOT_CORS_ORIGINS=*

# ── Twilio ConversationRelay TwiML attributes ───────────────────────────
TWILIO_LANGUAGE=en-CA
TWILIO_ASR_PROVIDER=deepgram
TWILIO_TTS_PROVIDER=ElevenLabs
TWILIO_VOICE_ID=uYXf8XasLslADfZ2MB4u
TWILIO_INTERRUPT_SENSITIVITY=medium

# Twilio account creds (used by Twilio SDK clients you might add).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Business facts (used in greetings + fallback strings) ───────────────
BUSINESS_NAME=AeroSports Scarborough
AGENT_NAME=Maya

# Literal forms — used when the LLM consumes them as instructions.
BUSINESS_PHONE=289-454-5555
BUSINESS_EMAIL=events.scb@aerosportsparks.ca

# Spoken (TTS-friendly) forms — used in canned strings sent to the caller.
BUSINESS_PHONE_SPOKEN=two eight nine, four five four, five five five five
BUSINESS_EMAIL_SPOKEN=events dot scb at aerosportsparks dot c a

# Echo-detection prefix used to suppress ASR catching the bot's own welcome
# greeting. Default aligned with the default greeting; override if you change
# BUSINESS_NAME.
WELCOME_ECHO_PREFIX=thank you for calling aerosports

# ── Logging ─────────────────────────────────────────────────────────────
SESSION_LOG_DIR=logs
