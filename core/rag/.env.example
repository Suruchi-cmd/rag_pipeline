# PostgreSQL (pgvector)
APP_PG_HOST=localhost
APP_PG_PORT=5433
APP_PG_USER=ultimateadvisor
APP_PG_PASSWORD=changeme
APP_PG_DATABASE=ultimateadvisor_db

# Vector store
APP_VECTOR_TABLE_NAME=documents

# Embedding (static - changing requires rebuilding vector table)
APP_EMBEDDING_MODEL=embeddinggemma
APP_EMBED_DIM=768

# Bootstrap defaults for LLMConfig table (first-boot seed only;
# after seeding, edit via PUT /settings/llm - these are ignored).
APP_DEFAULT_OLLAMA_BASE_URL=http://localhost:11434
APP_DEFAULT_CHAT_MODEL=gemma3:12b
APP_DEFAULT_REQUEST_TIMEOUT=120

# Auto-ingest parser/output/enriched/*.md on boot if vector table empty.
# Populate it first with: `cd parser && python run_parsers.py --enrich`.
APP_AUTO_INGEST=true

# Uvicorn server bindings (used when running `python src/main.py` directly)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_WORKERS=1
APP_LOG_LEVEL=info

# Chat LLM tuning (passed to Ollama)
APP_LLM_TEMPERATURE=0.3

# Document chunking — used when MarkdownNodeParser produces nodes larger
# than CHUNK_SIZE. Changing these requires re-indexing.
APP_CHUNK_SIZE=1000
APP_CHUNK_OVERLAP=200

# Retrieval — oversample then trim. effective_top_k =
#   min(request.top_k * RETRIEVAL_OVERSAMPLE, RETRIEVAL_MAX_K)
APP_RETRIEVAL_OVERSAMPLE=2
APP_RETRIEVAL_MAX_K=15
APP_SIMILARITY_CUTOFF=0.6
APP_RESPONSE_MODE=compact

# Resync subprocess timeouts (seconds). Enrichment is LLM-bound;
# raw parsing is fast.
APP_PARSER_TIMEOUT_ENRICH=1800
APP_PARSER_TIMEOUT_RAW=300

# DB bootstrap wait — covers pgvector container cold start.
APP_DB_WAIT_ATTEMPTS=30
APP_DB_WAIT_DELAY=2.0

# CORS — comma-separated list of allowed origins.
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8023,http://127.0.0.1:3000,http://127.0.0.1:8023
