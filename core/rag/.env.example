# PostgreSQL (pgvector)
APP_PG_HOST=localhost
APP_PG_PORT=5433
APP_PG_USER=ultimateadvisor
APP_PG_PASSWORD=changeme
APP_PG_DATABASE=ultimateadvisor_db

# Vector store
APP_VECTOR_TABLE_NAME=documents

# Embedding (static - changing requires rebuilding vector table)
APP_EMBEDDING_MODEL=embeddinggemma
APP_EMBED_DIM=768

# Bootstrap defaults for LLMConfig table (first-boot seed only;
# after seeding, edit via PUT /settings/llm - these are ignored).
APP_DEFAULT_OLLAMA_BASE_URL=http://localhost:11434
APP_DEFAULT_CHAT_MODEL=gemma3:12b
APP_DEFAULT_REQUEST_TIMEOUT=120

# Auto-ingest parser/output/enriched/*.md on boot if vector table empty.
# Populate it first with: `cd parser && python run_parsers.py --enrich`.
APP_AUTO_INGEST=true

# Uvicorn server bindings (used when running `python src/main.py` directly)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_WORKERS=1
APP_LOG_LEVEL=info
